# Copy this file to .env (same folder) and fill in your values. Never commit .env.

# --- AI assistant ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# Optional: enables the "Include web news" option in the assistant. Free key: https://tavily.com
TAVILY_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# --- Database ---
# Leave empty to use a local SQLite file (backend/app.db). Nothing to install.
# For production paste your Neon connection string (Neon dashboard > Connect > pooled connection):
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Accounts ---
# Long random value that signs login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Comma-separated emails that become administrators automatically
ADMIN_EMAILS=you@example.com
# Set to true once the site is served over HTTPS
COOKIE_SECURE=false
# SESSION_DAYS=7
# Only if the frontend is hosted on a different address than the API:
# CORS_ORIGINS=https://your-frontend.example.com
